{
  "entities": {
    "User": {
      "title": "User",
      "description": "Customer and administrator profile document",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "phone": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "displayName", "role", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Motorcycle parts and accessories customer order",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "customerEmail": { "type": "string", "maxLength": 256 },
        "shippingAddress": { "type": "string", "maxLength": 512 },
        "district": { "type": "string", "maxLength": 64 },
        "city": { "type": "string", "maxLength": 64 },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled"] },
        "paymentMethod": { "type": "string", "enum": ["cod", "bkash", "nagad", "rocket"] },
        "notes": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "customerName", "customerPhone", "shippingAddress", "totalAmount", "status", "paymentMethod", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product rating and review",
      "type": "object",
      "properties": {
        "reviewId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userPhoto": { "type": "string", "maxLength": 1024 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reviewId", "productId", "userId", "userName", "rating", "comment", "createdAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Contact or customer service inquiry",
      "type": "object",
      "properties": {
        "inquiryId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 256 },
        "subject": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["unread", "contacted", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inquiryId", "name", "phone", "message", "status", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator UID mapping",
      "type": "object",
      "properties": {
        "adminId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminId", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer motorcycle orders and tracking"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product ratings and reviews"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Customer queries and service inquiries"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "System admin verification documents"
    }
  }
}
