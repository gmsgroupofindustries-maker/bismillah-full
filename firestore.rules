rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gmsgroupofindustries@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId
        && incoming().userId == userId
        && incoming().email == request.auth.token.email
        && (incoming().role == 'customer' || (incoming().role == 'admin' && isAdmin()))
        && incoming().displayName is string && incoming().displayName.size() <= 128;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin())
        && incoming().userId == existing().userId
        && incoming().email == existing().email
        && (incoming().role == existing().role || isAdmin());
      allow delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId)
        && incoming().orderId == orderId
        && incoming().customerName is string && incoming().customerName.size() <= 128
        && incoming().customerPhone is string && incoming().customerPhone.size() <= 32
        && incoming().shippingAddress is string && incoming().shippingAddress.size() <= 512
        && incoming().totalAmount is number && incoming().totalAmount >= 0
        && incoming().status in ['pending', 'confirmed', 'processing', 'shipped', 'delivered', 'cancelled']
        && incoming().paymentMethod in ['cod', 'bkash', 'nagad', 'rocket'];
      allow update: if isValidId(orderId) && isAdmin();
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if isValidId(reviewId);
      allow create: if isValidId(reviewId) && isSignedIn()
        && incoming().reviewId == reviewId
        && incoming().userId == request.auth.uid
        && incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5
        && incoming().comment is string && incoming().comment.size() <= 1000;
      allow update, delete: if isValidId(reviewId) && (
        isAdmin() || (isSignedIn() && existing().userId == request.auth.uid)
      );
    }

    // Inquiries Collection
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId)
        && incoming().inquiryId == inquiryId
        && incoming().name is string && incoming().name.size() <= 128
        && incoming().phone is string && incoming().phone.size() <= 32
        && incoming().message is string && incoming().message.size() <= 2000;
      allow read, update, delete: if isValidId(inquiryId) && isAdmin();
    }

    // Admin Verification Collection
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId) && isAdmin();
    }
  }
}
