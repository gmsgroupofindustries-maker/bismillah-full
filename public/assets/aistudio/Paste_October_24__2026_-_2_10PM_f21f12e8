if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(204);
    exit;
}

require __DIR__ . '/config.php';
require __DIR__ . '/db.php';
require __DIR__ . '/helpers.php';

// .htaccess routes /api/foo/bar → index.php?path=foo/bar
$path = $_GET['path'] ?? '';
$path = trim($path, '/');
$method = $_SERVER['REQUEST_METHOD'];
$segments = $path ? explode('/', $path) : [];

// Routing table
switch (true) {
    case $segments[0] === 'products':
        require __DIR__ . '/routes/products.php';
        handle_products($method, $segments);
        break;
    case $segments[0] === 'orders':
        require __DIR__ . '/routes/orders.php';
        handle_orders($method, $segments);
        break;
    case $segments[0] === 'auth':
        require __DIR__ . '/routes/auth.php';
        handle_auth($method, $segments);
        break;
    case $segments[0] === 'categories':
        require __DIR__ . '/routes/categories.php';
        handle_categories($method, $segments);
        break;
    case $segments[0] === 'brands':
        require __DIR__ . '/routes/brands.php';
        handle_brands($method, $segments);
        break;
    case $segments[0] === 'bike-brands':
        require __DIR__ . '/routes/bike_brands.php';
        handle_bike_brands($method, $segments);
        break;
    default:
        http_response_code(404);
        echo json_encode(['error' => 'Not found', 'path' => $path]);
}
