# ----------------------------------------------------------------------
# BISMILLAH MOTORS - APACHE .HTACCESS FOR CPANEL (SPA + PHP API)
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route /api/* requests to api/index.php
  RewriteRule ^api/?$ api/index.php [QSA,L]
  RewriteRule ^api/(.+)$ api/index.php?path=$1 [QSA,L]

  # 2. SPA Fallback: serve index.html for non-file, non-directory routes
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule . /index.html [L]
</IfModule>

# MIME Types
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css               .css
  AddType application/json       .json
  AddType image/webp             .webp
  AddType image/svg+xml          .svg .svgz
  AddType font/woff2             .woff2
  AddType image/x-icon           .ico
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml font/woff2
</IfModule>

# Cache Control
<IfModule mod_expires.c>
  ExpiresActive On

  # Never cache index.html
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  ExpiresByType image/jpg             "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType application/json      "access plus 1 hour"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block direct browser access to sensitive config & metadata files
<FilesMatch "(^\.|\.env|config\.php$|schema\.sql$|package\.json|package-lock\.json)">
  Require all denied
</FilesMatch>
